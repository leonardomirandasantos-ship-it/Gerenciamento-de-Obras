# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase
# (Project Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Motor de IA (transcrição de áudio e leitura de comprovante).
# Fica SÓ no servidor: é lida pela rota /api/entender, nunca pelo front.
# Sem ela o app continua funcionando por texto e foto — o áudio é guardado,
# mas não é transcrito.
GEMINI_API_KEY=
# Opcional: trocar o modelo sem mexer no código.
GEMINI_MODEL=gemini-3.5-flash
